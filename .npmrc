# O React Native resolve módulos nativos por caminho físico durante o autolinking, e o
# node_modules simbólico e isolado do pnpm quebra essa busca. A documentação de monorepo
# do Expo pede exatamente isto para pnpm.
#
# Custo: perdemos o isolamento estrito (um pacote passa a "ver" dependências que não
# declarou). Vale a troca — o app Android não compila sem isso, e o único consumidor
# do modo estrito aqui seria disciplina que já mantemos à mão.
node-linker=hoisted
