{
  "openapi": "3.1.1",
  "info": {
    "title": "Reprise.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5156/"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Reprise.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/next-up": {
      "get": {
        "tags": [
          "Series"
        ],
        "summary": "Próximo episódio não visto de cada série acompanhada, por atividade recente.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NextUpItemDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/episodes/{id}/watch": {
      "post": {
        "tags": [
          "Watching"
        ],
        "summary": "Marca o episódio como visto (novo evento). Repetir = rewatch.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/MarkBody"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchStateDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "Watching"
        ],
        "summary": "Remove a exibição mais recente do episódio (decrementa o rewatch).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "clientKey",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchStateDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/series/{id}/seasons/{seasonNumber}/watch": {
      "post": {
        "tags": [
          "Watching"
        ],
        "summary": "Marca todos os episódios ainda não vistos da temporada.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "seasonNumber",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/MarkBody"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkMarkResult"
                }
              }
            }
          }
        }
      }
    },
    "/series/{id}/watch-up-to": {
      "post": {
        "tags": [
          "Watching"
        ],
        "summary": "Marca todos os episódios regulares até (temporada, episódio), ainda não vistos.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkUpToBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkMarkResult"
                }
              }
            }
          }
        }
      }
    },
    "/series": {
      "get": {
        "tags": [
          "Series"
        ],
        "summary": "Lista as séries acompanhadas com progresso derivado do log de eventos.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SeriesListItemDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/series/{id}": {
      "get": {
        "tags": [
          "Series"
        ],
        "summary": "Detalhe da série: temporadas e episódios com contagem de exibições (trilha de rewatch).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/stats/overview": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Resumo, distribuição por ano/mês, top séries e sequências. Backfill fora por padrão.",
        "parameters": [
          {
            "name": "includeBackfill",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOverviewDto"
                }
              }
            }
          }
        }
      }
    },
    "/stats/calendar": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Exibições por dia de um ano, para o heatmap. Só dias com atividade.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "includeBackfill",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CalendarDayDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
