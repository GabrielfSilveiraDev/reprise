<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Habilita `dotnet user-secrets` em desenvolvimento: é onde ficam Jwt:Secret e Tmdb:ApiKey
         quando a API roda com `dotnet run`, que não lê o .env. -->
    <UserSecretsId>reprise-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reprise.Application\Reprise.Application.csproj" />
    <ProjectReference Include="..\Reprise.Infrastructure\Reprise.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

</Project>
