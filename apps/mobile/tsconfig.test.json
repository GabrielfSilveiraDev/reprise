{
  // Config separada para os testes, e não `types: ["node"]` na do app, de propósito: o código do
  // app roda no Hermes, que não tem `process`, `Buffer` nem `node:*`. Misturar os dois deixaria
  // um uso acidental de API do Node passar na compilação e explodir só no aparelho.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "src/offline/**/*.ts", "src/api/client.ts"]
}
