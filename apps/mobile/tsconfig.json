{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // O `@reprise/shared` importa seus próprios arquivos com extensão `.ts`, para continuar
    // importável pelo Node puro (é assim que os testes da fila rodam sem emulador).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Os testes rodam no Node e têm config própria (`tsconfig.test.json`).
  "exclude": ["**/*.test.ts", "dist"]
}
