# OPCIONAL. Sem .env, o `docker compose up` sobe com os padrões abaixo. Copie para .env só para
# mudar alguma coisa. O .env real NUNCA vai pro repositório.
# O docker-compose lê este arquivo sozinho (o launcher do Windows, scripts/subir-reprise.ps1, sobe
# tudo pelo compose e só consulta algumas linhas daqui). O `dotnet run` NÃO o lê: fora do Docker,
# exporte as variáveis ou use user-secrets.

# ---- Auth (JWT) ----
# Vazio, a API gera um segredo aleatório na primeira partida e o guarda num volume do compose.
# Para usar o seu: openssl rand -base64 48 (32 caracteres ou mais).
Jwt__Secret=
Jwt__Issuer=reprise
Jwt__Audience=reprise-clients
# Cadastro fechado por padrão. Numa API exposta, aberto é porta aberta.
Jwt__AllowRegistration=false

# ---- Porta do Reprise no docker-compose (http://localhost:8080) ----
REPRISE_PORT=8080

# ---- Launcher do Windows (scripts/subir-reprise.ps1) ----
# A janela do launcher entra na conta sem pedir senha. Com uma conta confirmada só no banco, ela é
# a escolhida; com mais de uma, diga aqui qual entra direto (sem isto, o launcher abre na tela de
# login). Com o cadeado (Api__AccessToken) ligado, a janela pede a chave do servidor uma vez.
REPRISE_AUTOLOGIN_EMAIL=

# ---- Postgres (usado pelo docker-compose e pela API) ----
POSTGRES_USER=reprise
POSTGRES_PASSWORD=reprise
POSTGRES_DB=reprise
POSTGRES_PORT=5432

# ---- API fora do Docker ----
# No docker-compose a API fala com o banco pelo host `db` e ignora esta linha. Aceita também a URL
# de um Postgres hospedado (postgresql://usuario:senha@host/banco?sslmode=require).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=reprise;Username=reprise;Password=reprise

# ---- Banco na nuvem ----
# Vazio, o Reprise do compose usa o Postgres local (serviço `db`). Com a URL de um banco hospedado
# (a do Neon: postgresql://usuario:senha@host/banco?sslmode=require), o app, as migrações e a CLI
# (passwd, importação, enrich) passam a usar o banco da nuvem — o mesmo da versão hospedada.
DATABASE_URL=

# ---- TMDB (metadados) — obtenha em https://www.themoviedb.org/settings/api ----
# Opcional: sem chave, o acervo, as marcações e as estatísticas funcionam; a busca de séries novas
# e a atualização automática do catálogo ficam desligadas.
Tmdb__ApiKey=
Tmdb__Language=pt-BR

# ---- Cadeado de acesso ----
# Só preencha quando a API for sair da rede local (túnel de desenvolvimento, por exemplo).
# Vazio = desligado, que é o certo em casa. NÃO é autenticação: não identifica ninguém e não
# substitui o JWT acima; é uma porta trancada na frente da API inteira, inclusive do login.
# Gere com: openssl rand -hex 32
Api__AccessToken=

# ---- E-mail (código de validação de conta) ----
# Sem isto o cadastro continua funcionando, mas o código de seis dígitos vai para o LOG da API
# em vez do e-mail. É proposital: uma instalação caseira sem SMTP não deve ficar sem cadastro.
# Para Gmail, use uma "senha de app" — a senha da conta não funciona.
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Reprise
Smtp__UseSsl=true
