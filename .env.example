# Copie para .env e preencha. O .env real NUNCA vai pro repositório.
# O docker-compose lê este arquivo sozinho (e o launcher do Windows, scripts/subir-reprise.ps1, só
# usa o compose). O `dotnet run` NÃO o lê: fora do Docker, exporte as variáveis ou use user-secrets.

# ---- Auth (JWT) — OBRIGATÓRIO. Gere um segredo forte: openssl rand -base64 48 ----
Jwt__Secret=
Jwt__Issuer=reprise
Jwt__Audience=reprise-clients
# Cadastro fechado por padrão. Numa API exposta, aberto é porta aberta.
Jwt__AllowRegistration=false

# ---- Porta do Reprise no docker-compose (http://localhost:8080) ----
REPRISE_PORT=8080

# ---- Postgres (usado pelo docker-compose e pela API) ----
POSTGRES_USER=reprise
POSTGRES_PASSWORD=reprise
POSTGRES_DB=reprise
POSTGRES_PORT=5432

# ---- API fora do Docker ----
# No docker-compose a API fala com o banco pelo host `db` e ignora esta linha.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=reprise;Username=reprise;Password=reprise

# ---- TMDB (metadados) — obtenha em https://www.themoviedb.org/settings/api ----
# Opcional: sem chave, o acervo, as marcações e as estatísticas funcionam; a busca de séries novas
# e a atualização automática do catálogo ficam desligadas.
Tmdb__ApiKey=
Tmdb__Language=pt-BR

# ---- Cadeado de acesso ----
# Só preencha quando a API for sair da rede local (túnel de desenvolvimento, por exemplo).
# Vazio = desligado, que é o certo em casa. NÃO é autenticação: não identifica ninguém e não
# substitui o JWT acima; é uma porta trancada na frente da API inteira, inclusive do login.
# Gere com: openssl rand -hex 32
Api__AccessToken=

# ---- E-mail (código de validação de conta) ----
# Sem isto o cadastro continua funcionando, mas o código de seis dígitos vai para o LOG da API
# em vez do e-mail. É proposital: uma instalação caseira sem SMTP não deve ficar sem cadastro.
# Para Gmail, use uma "senha de app" — a senha da conta não funciona.
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Reprise
Smtp__UseSsl=true
